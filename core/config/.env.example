# =============================================
# Configuracoes de ambiente (NAO versionar)
# Copie para .env e preencha
# =============================================

# Ambiente: development | production
APP_ENV=development

# Banco de Dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meu_banco
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# URLs
APP_URL=http://localhost/meu-projeto

# Email
APP_ADMIN_EMAIL=admin@exemplo.com

# Rate Limiting (tentativas por minuto)
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
