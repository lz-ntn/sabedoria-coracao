# ═══════════════════════════════════════════════════════════════
# Variáveis de Ambiente — Deploy Render + TiDB Serverless
# ═══════════════════════════════════════════════════════════════
# Use este template para configurar seus serviços.
# 1. Crie um cluster TiDB Serverless em tidbcloud.com
# 2. Copie as credenciais do painel do TiDB
# 3. Preencha abaixo
# 4. NUNCA commite este arquivo com senhas reais
# ═══════════════════════════════════════════════════════════════

APP_ENV=production

# ─── TiDB Serverless ──────────────────────────────────────────
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_CHARSET=utf8mb4

# Portal Saberes
DB_NAME=portal_saberes
DB_USER=
DB_PASS=

# ─── Render Service URLs ──────────────────────────────────────
APP_URL=https://portal-saberes.onrender.com
